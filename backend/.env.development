# Environment variables for TeamSpeak One-Click Deploy

# TeamSpeak ServerQuery credentials
TEAMSPEAK_PASSWORD=03QM7Tiv
TEAMSPEAK_SERVER_QUERY_APIKEY=BAA9EK2vfUc9jFQ6uaJonHKGjgV5fm-khW3xpBI
TEAMSPEAK_SERVER_ADMIN_TOEKN=Aaard9lBZlPQGFNdjOy4DMViOe4e3Afauqc5B6sw
TEAMSPEAK_SERVER_ADMIN_USERNAME=serveradmin

# JWT secret for authentication token signing
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=$(openssl rand -base64 32)

# Server configuration
SERVER_PORT=8080
SERVER_ENV=development
SERVER_LOG_LEVEL=info

# Database configuration (optional - can also be in config.yaml)
DATABASE_DRIVER=sqlite
DATABASE_DSN=sqlite:///data/teamspeak.db
DATABASE_TYPE=sqlite
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=100
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_AUTO_MIGRATE=true

# Monitoring configuration
MONITORING_COLLECT_INTERVAL=60s

# Deployment configuration
DEPLOYMENT_SCRIPT_DIR=deploy-scripts
DEPLOYMENT_TIMEOUT=10m
