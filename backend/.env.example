# Environment variables for TeamSpeak One-Click Deploy


# Server configuration
SERVER_PORT=8080
SERVER_ENV=production
SERVER_LOG_LEVEL=info

# Database configuration (optional - can also be in config.yaml)
DATABASE_DRIVER=sqlite
DATABASE_DSN=sqlite:///data/teamspeak.db
DATABASE_TYPE=sqlite
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=100
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_AUTO_MIGRATE=true

# Monitoring configuration
MONITORING_COLLECT_INTERVAL=60s

# Deployment configuration
DEPLOYMENT_SCRIPT_DIR=deploy-scripts
DEPLOYMENT_TIMEOUT=10m

# Redis configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# TeamSpeak Query configuration
# For Docker Desktop (macOS/Windows) the default host can be host.docker.internal
# For Linux set this to your host gateway (e.g. 172.17.0.1 or the output of `ip route | awk '/default/ {print $3}'`)
TEAMSPEAK_HOST=10.2.8.1
TEAMSPEAK_QUERY_PORT=10011
